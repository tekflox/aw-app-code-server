{
  "mcpServers": {
    "vscode": {
      "enabled": true,
      "type": "stdio",
      "command": "python3",
      "args": [
        "-m",
        "mcp_server.server"
      ],
      "cwd": "/opt/aw-workspace/apps/code-server",
      "env": {
        "PYTHONUNBUFFERED": "1",
        "AW_APP_EVENT_TOKEN": "${app.event_token}",
        "AW_APP_EVENT_URL": "${app.event_url}"
      }
    }
  }
}
